#!/bin/sh

# CPU: emit Linux /proc/stat-compatible counters from FreeBSD kern.cp_time.
set -- $(sysctl -n kern.cp_time)
user=$1
nice=$2
sys=$3
intr=$4
idle=$5
echo "cpu $user $nice $sys $idle 0 $intr 0 0 0 0"

# Memory: emit Linux /proc/meminfo-compatible values in KiB.
page_size=$(sysctl -n hw.pagesize)
page_count=$(sysctl -n vm.stats.vm.v_page_count)
free_count=$(sysctl -n vm.stats.vm.v_free_count)
inactive_count=$(sysctl -n vm.stats.vm.v_inactive_count)
cache_count=$(sysctl -n vm.stats.vm.v_cache_count 2>/dev/null || echo 0)

mem_total=$((page_count * page_size / 1024))
mem_available=$(((free_count + inactive_count + cache_count) * page_size / 1024))

echo "MemTotal: $mem_total kB"
echo "MemAvailable: $mem_available kB"

# Root filesystem percentage.
df -P / | awk 'NR==2 {print $5}'

# Battery, if this machine exposes one through FreeBSD ACPI.
life=$(sysctl -n hw.acpi.battery.life 2>/dev/null || true)
state=$(sysctl -n hw.acpi.battery.state 2>/dev/null || true)

if [ -n "$life" ] && [ "$life" -ge 0 ] 2>/dev/null; then
    case "$state" in
        2) status="Charging" ;;
        *) status="Discharging" ;;
    esac
    echo "BAT $life $status"
fi
